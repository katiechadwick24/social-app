ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional but strongly recommended for a hosted copy.
# When set, the site will ask for a username/password.
# You can type anything for the username; this value is the password.
APP_PASSWORD=choose-a-private-password

# Optional. Useful on hosts with persistent disks.
# Example for Render persistent disk:
# STATE_FILE=/var/data/save.json
STATE_FILE=save.json
